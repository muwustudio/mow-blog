---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Format date
const dateStr = post.data.date instanceof Date
  ? post.data.date.toISOString().split('T')[0]
  : new Date(post.data.date).toISOString().split('T')[0];

// Cover image
const coverImage = post.data.image || '';

// Derive tags
const tags = post.data.tags && post.data.tags.length > 0
  ? post.data.tags
  : [post.data.project, post.data.type, ...post.data.tech, post.data.difficulty].filter(Boolean);
---

<MainLayout title={post.data.title} description={post.data.description} image={coverImage}>
  <article class="post-detail" style="max-width:820px;margin:0 auto;padding:60px 32px 100px;">
    <header style="margin-bottom:40px;text-align:center;">
      <time class="post-date" datetime={dateStr}>{dateStr}</time>
      <h1 style="font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;color:var(--text);margin:12px 0;line-height:1.3;">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p style="color:var(--text-secondary);font-size:1.05rem;line-height:1.7;">{post.data.description}</p>
      )}
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px;">
        {tags.map((tag: string) => (
          <span class="post-tag" style="background:var(--tag-bg);color:var(--tag-text);padding:3px 12px;border-radius:10px;font-size:0.84rem;">{tag}</span>
        ))}
      </div>
    </header>

    {coverImage && (
      <div class="post-cover" style="margin-bottom:36px;border-radius:12px;overflow:hidden;max-height:360px;">
        <img
          src={coverImage}
          alt={post.data.title}
          style="width:100%;height:360px;object-fit:cover;display:block;"
        />
      </div>
    )}

    <div class="post-content" style="color:var(--text);line-height:1.9;font-size:1.05rem;">
      <Content />
    </div>

    <footer style="margin-top:60px;padding-top:30px;border-top:1px solid var(--divider);text-align:center;">
      <a href="/" style="color:var(--accent);text-decoration:none;font-size:0.95rem;">← 返回首页</a>
    </footer>
  </article>
</MainLayout>
