---
// ============================================================
// BaseLayout — HTML shell, FOUC prevention, CSS, SVG icons, scene
// ============================================================
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const pageDesc = description || SITE.description;
const ogImage = image ? `${SITE.url}${image}` : SITE.ogImage;
---
<!DOCTYPE html>
<html lang={SITE.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={SITE.url} />
  <meta property="og:image" content={ogImage} />

  <!-- FOUC prevention: blocking inline script before first paint -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('blog-theme');
      if (t === 'day' || t === 'night') {
        document.documentElement.setAttribute('data-theme', t);
      } else {
        var h = new Date().getHours();
        document.documentElement.setAttribute('data-theme', (h >= 6 && h < 18) ? 'day' : 'night');
      }
    })();
  </script>

  <!-- CSS design system (global) -->
  <style is:global>
    @import '../styles/tokens.css';
  </style>
</head>
<body>
  <!-- SVG Icon Sprite -->
  <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <g id="icon-github">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5a4.3 4.3 0 0 0-1.5-3.2 3.3 3.3 0 0 0-.1-3.2s-1.1-.3-3.7 1.3a12.8 12.8 0 0 0-6.7 0C5.6 2.3 4.5 2.6 4.5 2.6a3.3 3.3 0 0 0-.1 3.2A4.3 4.3 0 0 0 2.9 9c0 3.5 3 5.5 6 5.5a4.8 4.8 0 0 0-1 3.5v4"/>
        <path d="M9 18c-4.5 1.5-4.5-2.5-6-3"/>
      </g>
      <g id="icon-search">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </g>
      <g id="icon-tag">
        <path d="M12.8 2.7 2.7 12.8a2 2 0 0 0 0 2.8l5.7 5.7a2 2 0 0 0 2.8 0l10.1-10.1a2 2 0 0 0 .5-1.2l1.1-5.7a1 1 0 0 0-1.1-1.1l-5.7 1.1a2 2 0 0 0-1.3.5Z"/>
        <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
      </g>
      <g id="icon-rss">
        <path d="M4 11a9 9 0 0 1 9 9"/>
        <path d="M4 4a16 16 0 0 1 16 16"/>
        <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/>
      </g>
      <g id="icon-external">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </g>
      <g id="icon-book">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        <line x1="8" y1="7" x2="16" y2="7"/>
        <line x1="8" y1="11" x2="14" y2="11"/>
      </g>
      <g id="icon-folder">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </g>
      <g id="icon-pin">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
        <circle cx="12" cy="10" r="3"/>
      </g>
      <g id="icon-mail">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 4-10 8L2 4"/>
      </g>
      <g id="icon-heart">
        <path d="M19 14c1.5-1.5 3-3.5 3-5.5A5.5 5.5 0 0 0 16.5 3C15 3 13.5 4 12 5.5 10.5 4 9 3 7.5 3A5.5 5.5 0 0 0 2 8.5c0 2 1.5 4 3 5.5l7 7 7-7Z"/>
      </g>
      <g id="icon-tv">
        <rect x="2" y="7" width="20" height="15" rx="2"/>
        <polyline points="17 2 12 7 7 2"/>
      </g>
      <g id="icon-music">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
      </g>
      <g id="icon-code">
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </g>
      <g id="icon-coffee">
        <path d="M17 8h1a4 4 0 0 1 0 8h-1"/>
        <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
        <line x1="6" y1="2" x2="6" y2="4"/>
        <line x1="10" y1="2" x2="10" y2="4"/>
        <line x1="14" y1="2" x2="14" y2="4"/>
      </g>
      <g id="icon-sun">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.2" y1="4.2" x2="5.6" y2="5.6"/>
        <line x1="18.4" y1="18.4" x2="19.8" y2="19.8"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.2" y1="19.8" x2="5.6" y2="18.4"/>
        <line x1="18.4" y1="5.6" x2="19.8" y2="4.2"/>
      </g>
      <g id="icon-moon">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
      </g>
    </defs>
  </svg>

  <!-- Scene — full-page parallax background -->
  <div class="scene" id="scene">
    <div class="bg-layer bg-day"></div>
    <div class="bg-layer bg-night"></div>
    <div class="paper-texture"></div>
    <div class="vignette"></div>
  </div>

  <!-- Foreground Effects -->
  <div class="steam-layer" id="steamLayer" aria-hidden="true">
    <div class="steam-wisp" style="--steam-dur:2.8s;--steam-delay:0s;--drift:6px;width:2px;height:20px;"></div>
    <div class="steam-wisp" style="--steam-dur:3.2s;--steam-delay:0.9s;--drift:-4px;width:1.5px;height:16px;"></div>
    <div class="steam-wisp" style="--steam-dur:2.5s;--steam-delay:1.8s;--drift:10px;width:2px;height:22px;"></div>
    <div class="steam-wisp" style="--steam-dur:3.6s;--steam-delay:0.4s;--drift:3px;width:1.5px;height:14px;"></div>
  </div>
  <div class="firefly-layer" id="fireflyLayer" aria-hidden="true"></div>

  <!-- Content -->
  <div class="content" id="content">
    <slot />
  </div>

  <!-- Sound Toggle -->
  <button class="sound-toggle" id="soundToggle" aria-label="开关环境音" title="环境音">
    <svg class="icon" style="width:1.2em;height:1.2em;"><use href="#icon-music"/></svg>
  </button>

  <!-- Easter Egg -->
  <button class="easter-egg" id="easterEgg" aria-label="风花雪月">
    🌙
    <span class="tooltip">我在风花雪月里等你</span>
  </button>

  <!-- Toast -->
  <div class="toast" id="toast"></div>
</body>
</html>
