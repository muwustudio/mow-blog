---
interface Props {
  post: any;
}

const { post } = Astro.props;

let derivedTags: string[] = [];
if (post.data.tags && post.data.tags.length > 0) {
  derivedTags = post.data.tags;
} else {
  const parts: string[] = [];
  if (post.data.project) parts.push(post.data.project);
  if (post.data.type) parts.push(post.data.type);
  if (post.data.tech && post.data.tech.length > 0) parts.push(...post.data.tech);
  if (post.data.difficulty) parts.push(post.data.difficulty);
  derivedTags = parts;
}

const dateObj = post.data.date instanceof Date ? post.data.date : new Date(post.data.date);
const dateStr = dateObj.toISOString().split('T')[0];
const coverImage: string = post.data.image || '';
const tagRotations = [-0.5, 1, -1.5, 0.5, -2, 1.5, -1, 0.5, -1.5, 2, -0.5];
const difficultyLabel = post.data.difficulty || '';
---

<article class="post-card" class:list={[{ 'has-cover': !!coverImage }]} data-tags={derivedTags.join(' ')}>
  {coverImage && (
    <a href={`/posts/${post.id}`} class="post-card-cover" aria-hidden="true" tabindex="-1">
      <img src={coverImage} alt="" loading="lazy" />
    </a>
  )}
  <div class="post-card-body">
    <div class="post-meta">
      <span class="post-date">{dateStr}</span>
      <span class="post-tags">
        {derivedTags.slice(0, 3).map((tag: string, i: number) => (
          <span class="post-tag" style={`--tag-rot:${tagRotations[i % tagRotations.length]}deg`}>{tag}</span>
        ))}
      </span>
    </div>
    <h3><a href={`/posts/${post.id}`}>{post.data.title}</a></h3>
    {post.data.description && <p class="post-excerpt">{post.data.description}</p>}
    {difficultyLabel && <span class="post-difficulty">{difficultyLabel}</span>}
  </div>
</article>
